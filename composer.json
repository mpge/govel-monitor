{
    "name": "mpge/govel-monitor",
    "description": "Real-time task monitoring dashboard for Govel.",
    "keywords": ["laravel", "govel", "monitoring", "dashboard", "go"],
    "license": "MIT",
    "authors": [
        {
            "name": "Govel Contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "mpge/govel": "^0.1",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Mpge\\GovelMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mpge\\GovelMonitor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mpge\\GovelMonitor\\GovelMonitorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
